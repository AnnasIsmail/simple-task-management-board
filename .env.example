# ============================================
# Docker Compose Environment Variables
# ============================================
# Copy this file to .env in the ROOT directory
# Usage: cp .env.example .env
# 
# This file is used by docker-compose.yml to configure
# all services (database, backend, frontend)
# ============================================

# ============================================
# Database Configuration
# ============================================
# These variables are used by PostgreSQL container
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=taskmanagement
DB_HOST=db
DB_PORT=5432

# ============================================
# Backend Configuration
# ============================================
# These variables are injected into backend container
NODE_ENV=development
BACKEND_PORT=3000
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:3000

# ============================================
# Frontend Configuration
# ============================================
# FRONTEND_API_URL is used during frontend build (build-time)
# Leave empty for production (uses nginx proxy to backend)
# Set to http://localhost:3000 for development/testing
FRONTEND_PORT=8080
FRONTEND_API_URL=http://localhost:3000